{
  "compilerOptions": {
    "types": ["mocha", "chai", "node"],
    "lib": ["es2022", "dom"],
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2022",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": [
    "programs/**/tests/**/*.ts",
    "tests/**/*.ts",
    "app/lib/**/*.ts",
    "app/app/api/**/*.ts"
  ]
}
