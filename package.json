{
  "name": "flint",
  "version": "0.1.0",
  "private": true,
  "license": "ISC",
  "description": "Flint — FRS-1 payment agreements on Solana (devnet). Root package: Anchor program tests.",
  "scripts": {
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:policy": "mocha --config .mocharc.agent.json --spec tests/agent/policy-engine.test.ts",
    "test:agent": "mocha --config .mocharc.agent.json"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.1.2",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  }
}
