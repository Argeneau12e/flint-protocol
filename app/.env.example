# Flint — environment template (devnet only).
#
# Copy to .env.local (gitignored) and adjust. Never commit real values, and
# never point this at mainnet: the build is devnet-only by design
# (FLINT_BUILD_CONTEXT.md Sections 6.3 and 12).
#
# Optional — leave unset to use the public devnet endpoint.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# --- Phase 2: agent / x402 flow -------------------------------------------------
# Produced by `node scripts/provision-devnet.mjs`, which writes most of this file.

# The deployed escrow program. Defaults to the devnet program id in lib/config.ts.
FLINT_PROGRAM_ID=ziZiaCVcDaenoUP7jHdEPk4R2XJ8zeY5UbMPKFuqZxE

# The recipient ("service") keypair: signs `create` when the endpoint answers 402.
# The agent ("payer") keypair: signs `fund`, and `release` when it settles.
# Both files are gitignored devnet throwaways. Never commit either.
FLINT_SERVICE_KEYPAIR=app/.keys/service.json
FLINT_AGENT_KEYPAIR=app/.keys/agent.json

# The SPL mint agreements are denominated in. The demo default is Circle's
# devnet USDC, taken from Circle's own contract-address page ("Solana Devnet"):
FLINT_ASSET_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Display-only symbol for that mint. Never sent to the program: FRS-1 stores the
# mint address, and the symbol is an app-layer lookup (Section 4.5). When unset,
# lib/config.ts claims "USDC" only for the exact mint above and "TST" otherwise.
# Automated tests pin their throwaway test mint in tests/.env.test — keep TST
# out of this file; this file is the demo configuration.
FLINT_ASSET_SYMBOL=USDC

# What the priced endpoint asks for, in base units, as a decimal string.
FLINT_PRICE_BASE_UNITS=1000000

# How long a proposed agreement stays valid. The program requires a strictly
# future expiry (Section 4.6) and reads time from the Clock sysvar only.
FLINT_AGREEMENT_TTL_SECONDS=900

# Append-only agent decision log (JSONL): every pay/no-pay decision, refusals
# included, with the full check-by-check evaluation.
FLINT_DECISION_LOG=app/.data/decisions.jsonl

# --- x402 endpoint rate limit (Section 6.3) -------------------------------------
# An *unpaid* request to /api/x402 proposes a real agreement on devnet, and the
# service wallet pays the rent for it — so the public endpoint is rate limited per
# client address before it does any work. These two values are the whole
# configuration; unset, `lib/throttle.ts` defaults to 12 requests per 60 seconds.
FLINT_X402_RATE_LIMIT=12
FLINT_X402_RATE_WINDOW_SECONDS=60

# --- Phase 6: delivery claim, review window, arbiter, evidence ----------------
# Names only, every value deployment-specific: real values live in .env.local
# (gitignored) or in the hosting provider's dashboard.
#
# Solana JSON-RPC endpoint. Unset falls back to the public devnet endpoint.
NEXT_PUBLIC_RPC_URL=
# Absolute origin of this deployment (e.g. https://flint.example). Used for
# absolute URLs in metadata and link-preview images.
NEXT_PUBLIC_SITE_URL=
# Deployed escrow program, treasury wallet and arbiter wallet — the three
# addresses FRS-1 v2 reads from chain. Public addresses, not secrets.
NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_TREASURY=
NEXT_PUBLIC_ARBITER=
# Vercel Blob write token: evidence storage. Server-side only, never public.
BLOB_READ_WRITE_TOKEN=
# Optional: email the payer when a delivery claim is recorded. Unset = the
# in-app share link is the only notification route, and nothing breaks.
RESEND_API_KEY=

